{
  "manifest_version": 3,
  "name": "NoDoomScroll – Block YouTube Shorts",
  "short_name": "NoDoomScroll",
  "version": "1.0.0",
  "description": "Hides YouTube Shorts (reels) everywhere they are suggested and opens Shorts links as normal videos.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_title": "NoDoomScroll",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*", "*://youtube.com/*"],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "nodoomscroll@example.com",
      "strict_min_version": "121.0"
    }
  }
}
